<Window x:Class="PCLDownloadFix.Gui.HmclWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HMCL 下载修复 - PCL 下载修复器（第三方）"
        Width="760" Height="560" MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9" FontFamily="Microsoft YaHei UI"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Icon="Assets/app.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="HMCL 下载修复" FontSize="24" FontWeight="Bold" Foreground="#1E293B" />
            <TextBlock Text="HMCL PR #7017 在中国大陆网络下禁用了下载页。本工具替换 RegionUtils 类，不修改其他代码。"
                       FontSize="12" Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Height="34" VerticalContentAlignment="Center"
                     Padding="10,0" FontSize="12.5" />
            <Button Grid.Column="1" Content="浏览..." Width="86" Height="34" Margin="8,0,0,0"
                    Click="Browse_Click" />
            <Button Grid.Column="2" Content="检测" Width="86" Height="34" Margin="8,0,0,0"
                    Click="Inspect_Click" />
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="文件类型" Foreground="#64748B" Margin="0,0,0,8" />
                <TextBlock x:Name="KindText" Grid.Column="1" Text="—" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Text="HMCL 版本" Foreground="#64748B" Margin="0,0,0,8" />
                <TextBlock x:Name="VersionText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,0,0,8" />
                <TextBlock Grid.Row="2" Text="地区限制" Foreground="#64748B" Margin="0,0,0,8" />
                <TextBlock x:Name="GateText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,0,0,8" />
                <TextBlock Grid.Row="3" Text="原版备份" Foreground="#64748B" />
                <TextBlock x:Name="BackupText" Grid.Row="3" Grid.Column="1" Text="—"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#E8F0FE" CornerRadius="8" Padding="12" Margin="0,14,0,0"
                VerticalAlignment="Top">
            <TextBlock Foreground="#475569" FontSize="11.5" TextWrapping="Wrap"
                       Text="支持 HMCL 官方 .jar 和 .exe（EXE = HMCLauncher.exe + 追加 JAR）。修复前会自动创建 .hmcl-original.bak；若 HMCL 自动更新，请重新修复。FCL 是 Android APK，需要修改 DEX 并重新签名，正在适配中。" />
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="#64748B" FontSize="11.5"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="选择或拖入 HMCL 的 JAR/EXE。" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="恢复原版" Width="100" Height="34" Margin="0,0,8,0"
                        Click="Restore_Click" />
                <Button Content="修复下载" Width="100" Height="34" Background="#2563EB"
                        Foreground="White" BorderThickness="0" Click="Patch_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
