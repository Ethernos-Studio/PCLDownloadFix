<Window x:Class="PCLDownloadFix.Gui.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="免责声明 - PCL 下载修复器（第三方）"
        Width="680" Height="650"
        MinWidth="620" MinHeight="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#F1F5F9"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        Icon="Assets/app.ico"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#1E293B" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.90" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#3576F2" Offset="0" />
                    <GradientStop Color="#1E4FC4" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="12" Background="#26FFFFFF">
                    <Viewbox Margin="9">
                        <Path Data="M12,3 L22,21 L2,21 Z M12,9 L12,14 M12,17 L12,17.5"
                              Stroke="White" StrokeThickness="2.1"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Fill="Transparent" />
                    </Viewbox>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="使用前请阅读免责声明" FontSize="19" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="PCL 下载修复器（第三方） · Ethernos Studio"
                               FontSize="11.5" Foreground="#D6E4FF" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="22,18,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
                    <StackPanel>
                        <TextBlock x:Name="DisclaimerBody" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="#334155" LineHeight="23" />
                        <TextBlock Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#475569">
                            <Run Text="项目主页：" />
                            <Hyperlink NavigateUri="https://github.com/Ethernos-Studio/PCLDownloadFix"
                                       RequestNavigate="Link_RequestNavigate">Ethernos-Studio/PCLDownloadFix</Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#475569">
                            <Run Text="参考项目：" />
                            <Hyperlink NavigateUri="https://github.com/Jelly10086/PCL-Re.Download_PATCH"
                                       RequestNavigate="Link_RequestNavigate">Jelly10086/PCL-Re.Download_PATCH</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="1" Margin="2,14,2,0">
                <CheckBox x:Name="AgreeCheck"
                          Content="我已阅读并理解以上内容，自愿承担使用风险"
                          Checked="AgreeCheck_Changed" Unchecked="AgreeCheck_Changed" />

                <Grid Margin="0,12,0,0">
                    <TextBlock Text="© 2026 Ethernos Studio · 本工具与 PCL 官方无关"
                               FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="退出" Width="94" Style="{StaticResource SecondaryButton}"
                                IsCancel="True" Click="Exit_Click" />
                        <Button x:Name="ContinueButton" Content="我已知晓，继续" Width="152"
                                Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False"
                                Margin="8,0,0,0" Click="Continue_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
